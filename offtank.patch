 -- Module code
 ---------------------------------------------------------------------------------------------------
 
--- UnitIsUnit returns secret values in instances in Midnight, so off-tank detection no longer works.
+-- Experimental Forever off-tank detection. Never infer safety from secret data.
+local IsSecretValue = _G.issecretvalue or function() return false end
+
+local function IsReadableTrue(value)
+  return not IsSecretValue(value) and value == true
+end
+
+local function IsForeverUnitOfftanked(unitid)
+  if not ShowOffTank or Addon.GetPlayerRole() ~= "tank" then return false end
+
+  local in_raid = _G.IsInRaid()
+  local count = in_raid and _G.GetNumGroupMembers() or _G.GetNumSubgroupMembers()
+  local prefix = in_raid and "raid" or "party"
+  for i = 1, count do
+    local tank_unit = prefix .. i
+    local is_player = UnitIsUnit("player", tank_unit)
+    if not IsSecretValue(is_player) and not is_player and IsReadableTrue(UnitExists(tank_unit)) then
+      local role = _G.UnitGroupRolesAssigned(tank_unit)
+      local assigned = GetPartyAssignment and GetPartyAssignment("MAINTANK", tank_unit)
+      local is_tank = (not IsSecretValue(role) and role == "TANK") or IsReadableTrue(assigned)
+      if is_tank then
+        local status = UnitThreatSituation(tank_unit, unitid)
+        if not IsSecretValue(status) and type(status) == "number" and status >= 2 then
+          return true
+        end
+      end
+    end
+  end
+  return false
+end
+
 local function CheckIfUnitIsOfftanked(unit, threat_level, other_player_has_aggro)
+  if Addon.IS_FOREVER then
+    -- Clear on every evaluation: unknown threat must never leave a stale safe color.
+    unit.IsOfftanked = other_player_has_aggro and IsForeverUnitOfftanked(unit.unitid) or false
+    return unit.IsOfftanked and "OFFTANK" or threat_level
+  end
   -- Reset IsOfftanked if the player is tanking
